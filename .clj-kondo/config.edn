{:config-paths ["../resources/clj-kondo.exports/zcaudate/tahto"]

 :ns-groups
 [{:pattern "^xt\\."
   :name clj-kondo.hooks.tahto-xtalk}
  {:pattern "^hara\\.model\\.spec-xtalk\\."
   :name clj-kondo.hooks.tahto-xtalk}
  {:pattern ".+"
   :name clj-kondo.hooks.tahto-postgres}]

 :hooks
 {:analyze-call
  {tahto.core/script clj-kondo.hooks.tahto-postgres/script
   tahto.core/script- clj-kondo.hooks.tahto-postgres/script
   tahto.core/script+ clj-kondo.hooks.tahto-postgres/script
   tahto.core/defspec.xt clj-kondo.hooks.tahto-xtalk/defspec-xt
   tahto.typed/defspec.xt clj-kondo.hooks.tahto-xtalk/defspec-xt
   defspec.xt clj-kondo.hooks.tahto-xtalk/defspec-xt
   def$.xt clj-kondo.hooks.tahto-xtalk/defvar-xt
   defn.xt clj-kondo.hooks.tahto-xtalk/defn-xt
   defn/xt clj-kondo.hooks.tahto-xtalk/defn-xt
   def.xt clj-kondo.hooks.tahto-xtalk/def-xt
   defmacro.xt clj-kondo.hooks.tahto-xtalk/defmacro-xt
   defgen.xt clj-kondo.hooks.tahto-xtalk/defgen-xt
   defvar.xt clj-kondo.hooks.tahto-xtalk/defvar-xt
   defprotocol.xt clj-kondo.hooks.tahto-xtalk/defprotocol-xt
   xt.lang.common-protocol/defprotocol.xt clj-kondo.hooks.tahto-xtalk/defprotocol-xt
   proto/defprotocol.xt clj-kondo.hooks.tahto-xtalk/defprotocol-xt
   defglobal.xt clj-kondo.hooks.tahto-xtalk/defglobal-xt
   defimpl.xt clj-kondo.hooks.tahto-xtalk/defimpl-xt
   xt.lang.common-protocol/defimpl.xt clj-kondo.hooks.tahto-xtalk/defimpl-xt
   proto/defimpl.xt clj-kondo.hooks.tahto-xtalk/defimpl-xt
   defn.js clj-kondo.hooks.tahto-xtalk/defn-xt
   tahto.core/defn.js clj-kondo.hooks.tahto-xtalk/defn-xt
   defvar.js clj-kondo.hooks.tahto-xtalk/defvar-xt
   tahto.core/defvar.js clj-kondo.hooks.tahto-xtalk/defvar-xt
   clj-kondo.hooks.tahto-xtalk/defn.xt clj-kondo.hooks.tahto-xtalk/defn-xt
   clj-kondo.hooks.tahto-xtalk/def.xt clj-kondo.hooks.tahto-xtalk/def-xt
   clj-kondo.hooks.tahto-xtalk/defmacro.xt clj-kondo.hooks.tahto-xtalk/defmacro-xt
   clj-kondo.hooks.tahto-xtalk/defgen.xt clj-kondo.hooks.tahto-xtalk/defgen-xt
   clj-kondo.hooks.tahto-xtalk/defvar.xt clj-kondo.hooks.tahto-xtalk/defvar-xt
   clj-kondo.hooks.tahto-xtalk/defglobal.xt clj-kondo.hooks.tahto-xtalk/defglobal-xt
   clj-kondo.hooks.tahto-xtalk/def$.xt clj-kondo.hooks.tahto-xtalk/defvar-xt
   fact clj-kondo.hooks.tahto-xtalk/fact-xt
   fact:global clj-kondo.hooks.tahto-xtalk/fact-global-xt
   code.test/fact clj-kondo.hooks.tahto-xtalk/fact-xt
   code.test/fact:global clj-kondo.hooks.tahto-xtalk/fact-global-xt
   defn.pg clj-kondo.hooks.tahto-postgres/defn-pg
   defrun.pg clj-kondo.hooks.tahto-postgres/defn-pg
   clj-kondo.hooks.tahto-postgres/defn.pg clj-kondo.hooks.tahto-postgres/defn-pg
   clj-kondo.hooks.tahto-postgres/defrun.pg clj-kondo.hooks.tahto-postgres/defn-pg
   deftype.pg clj-kondo.hooks.tahto-postgres/deftype-pg
   clj-kondo.hooks.tahto-postgres/deftype.pg clj-kondo.hooks.tahto-postgres/deftype-pg
   std.lib/intern-in hooks.std-lib/intern-in-hook
   std.lib/intern-all hooks.std-lib/intern-all-hook
   f/intern-in hooks.std-lib/intern-in-hook
   f/intern-all hooks.std-lib/intern-all-hook}}

 :linters
  {:namespace-name-mismatch {:level :off}
   :unused-namespace {:exclude [std.lib xt.lang.spec-base]}
  :use {:level :off}
  :unused-referred-var {:level :off}
  :unused-excluded-var {:level :off}
  :unresolved-var {:exclude [l/script l/script- l/script+
                             tahto.core/script tahto.core/script- tahto.core/script+
                             tahto.core/defspec.xt
                             tahto.model.spec-xtalk.fn-python
                             tahto.core.impl
                             code.test/fact code.test/fact:global
                             code.test/=> code.test/contains]}
  :duplicate-require {:level :off}
  :unresolved-symbol {:exclude [fact fact:global defn.pg defrun.pg deftype.pg
                                canonical-conditional redundant-access
                                defaulted-access fn-arrow-canonical fn-arrow-fact
                                nested-dot-access nested-dot-fact
                                test-python-fn-direct-assignment
                                test-python-fn-invoke-argument
                                test-python-typed-canonical-access
                                destructuring-collision destructuring-source
                                redundant-dot-binding
                                loop-context]}
  :tahto.postgres/one-let {:level :warning}
  :tahto.postgres/nested-let {:level :warning}
   :tahto.postgres/input-prefix {:level :warning}
   :tahto.postgres/local-prefix {:level :warning}
  :tahto.postgres/return-bound {:level :warning}
  :tahto.postgres/retired-entity-option {:level :error}
  :tahto.postgres/invalid-owner {:level :error}
  :tahto.postgres/invalid-provides {:level :error}
  :tahto.xtalk/block-in-value {:level :error}
  :tahto.xtalk/redundant-get-key {:level :warning}
  :tahto.xtalk/redundant-fn-arrow {:level :warning}
  :tahto.xtalk/nested-dot-access {:level :warning}
  :tahto.xtalk/complex-destructuring-source {:level :warning}
  :tahto.xtalk/redundant-dot-destructure {:level :warning}
  :tahto.xtalk/merge-dot-destructure {:level :warning}
  :tahto.xtalk/field-collision {:level :error}
  :tahto.xtalk/invalid-destructuring {:level :error}}
 :config-in-ns
 {tahto.model.spec-python
  {:linters {:syntax {:level :off}
             :invalid-arity {:level :off}
             :unsupported-binding {:level :off}
             :unresolved-symbol {:level :off}
             :unresolved-var {:level :off}
             :unresolved-namespace {:level :off}}}
  tahto.model.annex.spec-xtalk.fn-ruby
  {:linters {:syntax {:level :off}
             :invalid-arity {:level :off}
             :unsupported-binding {:level :off}
             :unresolved-symbol {:level :off}
             :unresolved-var {:level :off}
             :unresolved-namespace {:level :off}}}
  ruby.lang.concurrent-promise
  {:linters {:syntax {:level :off}
             :invalid-arity {:level :off}
             :unsupported-binding {:level :off}
             :unresolved-symbol {:level :off}
             :unresolved-var {:level :off}
             :unresolved-namespace {:level :off}}}}
 :lint-as {defn.xt clojure.core/defn
           defgen.xt clojure.core/defn
           def.xt clojure.core/def
           defvar.xt clojure.core/def}}
